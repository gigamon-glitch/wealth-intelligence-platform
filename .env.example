# Database (example matches docker-compose default)
DATABASE_URL="postgresql://wealth:wealth_dev@localhost:5433/wealth_intel?schema=public"

# NextAuth — required (non-empty). Generate with: openssl rand -base64 32
# Leaving this empty causes: "There is a problem with the server configuration"
NEXTAUTH_SECRET=""
# Must match the URL in the browser exactly (localhost vs 127.0.0.1 matters for cookies)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI — server-side only; never expose to the browser
OPENAI_API_KEY=""
# Optional: model override (defaults to gpt-4o-mini). Use gpt-4o for deeper reasoning at higher cost.
OPENAI_MODEL="gpt-4o-mini"

# Optional: AES-256-GCM key for encrypting sensitive note fields (32 bytes base64)
# openssl rand -base64 32
ENCRYPTION_KEY=""

# Optional: metals spot prices — leave empty to use built-in fallback + cache
METALS_API_KEY=""
METALS_API_URL=""

# Yahoo Finance is used optionally for quote refresh (unofficial; rate-limit aware)
# No key required for light usage

# Demo auth: set to true in local dev only to sign in without Google (seed user)
DEMO_AUTH="false"

# Skip auto Docker + prisma db push before next dev (when you manage Postgres yourself)
# SKIP_DB_ENSURE="1"
